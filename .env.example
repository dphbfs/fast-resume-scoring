# Copy to .env (gitignored) and fill in. The Makefile's eval targets load
# .env automatically; for the CLIs, export it first:
#   set -a; . ./.env; set +a

# --- Jev (TypeSafe System One), required --------------------------------
# Direct TypeSafe API, or OpenRouter (same request/response shapes; 32k
# tokens per request):
#   TYPESAFE_BASE_URL=https://openrouter.ai/api
#   TYPESAFE_API_KEY=<OpenRouter key>
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest          # or a pinned version, e.g. jev-1.13
# JEV_MAX_CONCURRENCY=8         # bounded limiter in front of Jev
# JEV_MAX_RETRIES=4
# JEV_TIMEOUT=30s

# --- Generative model, optional -----------------------------------------
# Any OpenAI-compatible chat API. Only writes the Job Summary for `extract`
# (falls back to the job title + requirement sentences when unset), and
# runs the generative baseline arm in `eval -checker -baseline`.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=                 # no default; empty = not configured
# GEN_MAX_CONCURRENCY=1
# GEN_TIMEOUT=60s

# --- Run ----------------------------------------------------------------
# RUN_DEADLINE=120s             # whole-run limit for extract, check, score
# TUNING_FILE=                  # edited copy of tuning/tuning.yaml (prompts, weights)
# LOG_LEVEL=info                # debug | info | warn | error (slog JSON on stderr)

# --- Requirement Extractor tuning ---------------------------------------
# PIPELINE_MAX_WINDOW_WORDS=4
# PIPELINE_SECTION_BATCH=60
# PIPELINE_MIN_REQUIREMENT_MASS=0.7
# PIPELINE_SKIP_IMPORTANCE=false
# PIPELINE_SKIP_RESPONSIBILITIES=false

# --- Resume Checker tuning (see docs/tuning.md) -------------------------
# CHECKER_RETRIEVAL_K=8
# CHECKER_RETRIEVAL_FLOOR=0.01
# CHECKER_NARROW_SIZES=16       # "none" = one retrieval round
# CHECKER_GATE_THRESHOLD=0.5    # 0 = gate off, uses CHECKER_MIN_EVIDENCE_MASS
# CHECKER_MIN_EVIDENCE_MASS=0.5
# CHECKER_GATE_FIRST=true
# CHECKER_SKIP_CAPPED_GRADING=true
# CHECKER_SKIP_MENTIONED=false
