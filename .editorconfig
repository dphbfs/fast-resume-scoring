# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.py]
indent_size = 4

# Markdown uses two trailing spaces for a line break.
[*.md]
trim_trailing_whitespace = false

# Job postings, resumes, and recorded outputs are kept byte-for-byte:
# editing whitespace would change eval inputs and cache keys.
[{testdata,examples,eval}/**]
trim_trailing_whitespace = false
insert_final_newline = unset

[*.pdf]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
